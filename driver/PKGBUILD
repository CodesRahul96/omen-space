# Original Maintainer: Vilez0 <aur at medip dotdev>

_pkgbase=hp-omen-extra
pkgname=${_pkgbase}-dkms
pkgver=$(grep -oP 'PACKAGE_VERSION="\K[^"]+' dkms.conf)
pkgrel=1
pkgdesc="DKMS driver for HP Omen/Victus laptops (fan control and extra features)"
url="https://github.com/yunusemreyl/omen-space"
license=("GPL")
arch=('x86_64')
depends=('glibc' 'dkms')
makedepends=()
conflicts=("${_pkgbase}" "hp-wmi-fan-and-backlight-control-dkms" "hp-rgb-lighting-dkms")
provides=("${_pkgbase}")
source=('dkms.conf' 'hp-wmi.c' 'hp-omen-extra.c' 'Makefile')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
	install -Dm644 'dkms.conf' "${pkgdir}/usr/src/${_pkgbase}-${pkgver}/dkms.conf"
	install -Dm644 'hp-wmi.c' "${pkgdir}/usr/src/${_pkgbase}-${pkgver}/hp-wmi.c"
	install -Dm644 'hp-omen-extra.c' "${pkgdir}/usr/src/${_pkgbase}-${pkgver}/hp-omen-extra.c"
	install -Dm644 'Makefile' "${pkgdir}/usr/src/${_pkgbase}-${pkgver}/Makefile"
}
